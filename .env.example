# 복사해서 .env로 사용 (cp .env.example .env). .env는 git에 올리지 않는다.

# 웹 서버 포트 (Docker에서는 WEB_PORT가 서버에 열리는 포트)
PORT=8080
WEB_PORT=8080

# Docker(docker-compose.yml)로 띄울 때 Redis 비밀번호. 이때 REDIS_URL은 compose가 알아서 정함
REDIS_PASSWORD=

# YOBA가 값을 쓰는 Redis (YOBA configs/service.yaml의 redis.url과 같게)
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=yoba

# 어드민 비밀번호 (필수, 운영 전에 반드시 바꾸기). --demo 모드에서는 비어 있으면 "admin"
ADMIN_PASSWORD=

# 통계 DB 파일 (SQLite)
DB_PATH=data/yoba-web.db

# 스트림이 이 시간(ms) 이상 갱신되지 않으면 "확인 불가"
STALE_MS=3000

# 화면 숫자 스무딩 시간상수(초). 클수록 숫자가 덜 튐
SMOOTHING_SECONDS=2

# WebSocket 푸시 주기(ms)
PUSH_INTERVAL_MS=500

# Redis에서 최신 프레임을 읽는 주기(ms)와 MJPEG 최대 송출 fps, 동시 MJPEG 시청자 상한
FRAME_POLL_MS=100
STREAM_MAX_FPS=8
STREAM_MAX_CLIENTS=30

# 리버스 프록시(nginx 등) 뒤에서 돌릴 때 1 (로그인 시도 제한에 실제 IP 사용)
TRUST_PROXY=0
